#!/bin/bash
# voice        start voicevr (runs in the background, keeps going if this terminal closes)
# voice stop   stop it
# voice log    follow the log
case "$1" in
  stop) systemctl --user stop voicevr && echo "voicevr stopped" ;;
  log)  exec tail -f ~/.cache/voicevr/voicevr.log ;;
  *)    if systemctl --user is-active -q voicevr; then echo "voicevr is already running"; exit 0; fi
        systemctl --user start voicevr
        echo "starting voicevr..."; sleep 2   # let run.sh clear the old log first
        until grep -q '^.* ready:' ~/.cache/voicevr/voicevr.log 2>/dev/null || ! systemctl --user is-active -q voicevr; do sleep 1; done
        if systemctl --user is-active -q voicevr; then echo "voicevr ready (voice stop to stop)"; else echo "voicevr failed, see: voice log"; fi ;;
esac
